# Required before exposing this service through a tunnel.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CODEX_REMOTE_TOKEN=

# Bind to 127.0.0.1 when using Cloudflare Tunnel, frp, or another local forwarder.
CODEX_REMOTE_HOST=127.0.0.1
CODEX_REMOTE_PORT=8765

# Optional. Defaults to your Windows user profile .codex directory.
CODEX_HOME=

# Keep this off until you deliberately wire a trusted Codex/agent command.
# Allowed values: mock, powershell-echo, command
CODEX_REMOTE_RUNNER=mock

# Interactive terminal bridge. On Windows the default is cmd.exe with UTF-8 output.
# Use the web terminal to run claude, codex, gemini, or a trusted local wrapper.
CODEX_REMOTE_TERMINAL_COMMAND=cmd.exe
CODEX_REMOTE_TERMINAL_ARGS=/Q /K "chcp 65001>nul"

# Used only when CODEX_REMOTE_RUNNER=command.
# The prompt is passed in CODEX_REMOTE_PROMPT_FILE and should be read by your command.
CODEX_REMOTE_COMMAND=

# Optional bearer token required for tunnel health checks or automation.
CODEX_REMOTE_ADMIN_TOKEN=
